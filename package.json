{
  "name": "open-topper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/sync-pdf-runtime-data.js && next build",
    "start": "next start",
    "lint": "eslint",
    "sync-pdf-runtime": "node scripts/sync-pdf-runtime-data.js",
    "build-data": "tsx scripts/build-data.ts",
    "preprocess": "tsx scripts/preprocess.ts",
    "build-ingest-queue": "tsx scripts/build-ingest-queue.ts",
    "download-pdfs": "tsx scripts/download-pdfs.ts",
    "build-entities": "tsx scripts/build-entities.ts",
    "build-ocr": "tsx scripts/build-ocr-links.ts",
    "build-themes": "tsx scripts/build-themes.ts",
    "build-vault": "tsx scripts/build-vault.ts",
    "build-workspace-index": "tsx scripts/build-workspace-index.ts",
    "build-vault-db": "tsx scripts/build-vault-db.ts",
    "build-search-spine": "tsx scripts/build-search-spine.ts",
    "backfill-search-embeddings": "tsx scripts/backfill-search-embeddings.ts",
    "build-pyqs": "node scripts/build-pyq-app-data.js && tsx scripts/build-official-pyq-links.ts",
    "build-official-links": "tsx scripts/build-official-pyq-links.ts",
    "build-all": "tsx scripts/build-entities.ts && tsx scripts/build-ocr-links.ts && tsx scripts/build-themes.ts",
    "import-upsckata": "tsx scripts/import-upsckata.ts",
    "filter-broken-pdfs": "tsx scripts/filter-broken-pdf-links.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/lib-storage": "^3.1057.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@types/pg": "^8.20.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
