{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upscat-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "upscat-web"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "upscat-opennext-cache",
      "preview_bucket_name": "upscat-opennext-cache-preview"
    },
    {
      "binding": "UPSCAT_RUNTIME_DATA",
      "bucket_name": "upscat-runtime-data",
      "preview_bucket_name": "upscat-runtime-data-preview"
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "ENABLE_LOCAL_EMBEDDINGS": "false",
    "UPSCAT_RUNTIME_DATA_PREFIX": "runtime/v1"
  }
}
