# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# large local data (not served by Next.js)
/local-pdfs/
/data-sources/
/public/data/
/vault_merged_docs/
/extracted_data/
/data/mappings/
/data/app/questions.json
/data/app/ocr-summaries.json
/data/app/pdf-map.json
/data/app/pdf-r2-map.json
/data/app/answer-sources.json
/data/app/entities/
*.har
*.xlsx

# typescript
*.tsbuildinfo
next-env.d.ts

# generated app data
data/app/
!data/app/public-official-pyq-links.json
data/relational/

# python
__pycache__/
*.py[cod]
# local Python environments
/.venv/

# local editor/tooling state
/.vscode/
/.mcp.json
/.mcp.json.example
/.reasonix/
/.kiro/

# root-level local media/import artifacts
/*.pdf
/*.pdf_thumb.jpg
/*.mov
/*.mov_thumb.jpg
/*.apkg
# additional local-only roots/tooling/media hardening
/.mcp/
/.vscode*/
/.venv*/
/*.mp4
/*.m4v
/*.avi
/*.mkv
/*.webm
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.webp
/*.tif
/*.tiff
/*.wav
/*.mp3
/*.m4a
/*.docx
/*.pptx
/*.xls
/*.xlsm
